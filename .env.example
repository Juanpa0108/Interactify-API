# Puerto del servidor
PORT=5000

# Opciones para inicializar Firebase Admin (elige una):
# 1) Ruta al JSON de la cuenta de servicio (local)
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# 2) O usar el JSON codificado en base64 (útil en despliegues)
# FIREBASE_SERVICE_ACCOUNT_BASE64=eyJ0eXAiOiJKV1QiLCJhbGciOiJ...

# Si usas Realtime Database o necesitas DB URL
# FIREBASE_DATABASE_URL=https://your-project-id.firebaseio.com
